{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" is here for vite.config.ts, which this tsconfig includes and which
    // imports node:child_process / node:url and reads process.env. Without it
    // `npm run check` fails, and `build` runs `check` first.
    "types": ["vite/client", "google.maps", "@testing-library/jest-dom", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // TypeScript 6 deprecates `baseUrl`; `paths` alone resolves fine and Vite
    // 8 reads the same mapping natively via `resolve.tsconfigPaths`.
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*", "*.ts", "*.config.ts", "vitest-setup.ts"]
}
