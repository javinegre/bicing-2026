# Google Maps JavaScript API key.
# The map is the app; without this the Map screen renders its chrome but no
# tiles. Create a browser key in Google Cloud Console, restrict it by HTTP
# referrer, and enable "Maps JavaScript API".
VITE_GOOGLE_MAPS_API_KEY=

# Base URL of the Bicing API (apis/bicing-api, mounted at /bicing/api by
# negre.co-server). Leave as-is to hit production from a local dev server;
# point it at http://localhost:8080/bicing/api to run against a local router.
VITE_BICING_API_BASE_URL=https://negre.co/bicing/api

# Set to "true" to skip the real passkey session and preview signed-in-only
# screens (Search, Saved) locally. Never set this outside your own .env.
VITE_DEV_FAKE_SESSION=false
